# Copy to .env (git-ignored) and fill in. Never commit real values.

# Random value, at least 32 characters. Must be the same for every Observer process.
#   openssl rand -hex 32
OBSERVER_COOKIE_SECRET=

# scrypt hash of the admin password (min 12 characters). Generate it with:
#   python run.py hash-password
# Hashes contain no shell-special characters, so no quoting is needed.
OBSERVER_ADMIN_PASSWORD_HASH=

# production (default in Compose): refuses to start without the two values above, Secure cookies.
# development: for local runs over plain HTTP on a non-localhost host.
# OBSERVER_ENV=production
# OBSERVER_COOKIE_SECURE=
# OBSERVER_SESSION_TTL_SECONDS=28800
# Extra dashboard origins allowed to call the live/compute/simulator services (comma separated).
# OBSERVER_ALLOWED_ORIGINS=

# --- Alerts and probes (monitor process) ---
# Seconds without data before an agent is reported down (at least 3x the agent's own interval).
# OBSERVER_DOWN_AFTER_SECONDS=15
# Every up/down change is logged; optionally also POSTed as JSON (a "text" field is included for chat tools).
# OBSERVER_ALERT_WEBHOOK_URL=
# If set, requests carry X-Observer-Signature: sha256=<hmac of the body>.
# OBSERVER_ALERT_WEBHOOK_SECRET=
# Host path of the probes file mounted into the monitor container (see deploy/probes.example.toml).
# OBSERVER_PROBES_FILE_HOST=./deploy/probes.toml
