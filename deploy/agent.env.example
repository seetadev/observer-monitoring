# /etc/observer-agent/agent.env  (no secrets here; the token lives in /etc/observer-agent/token, mode 600)
OBSERVER_AGENT_SERVER=observer.example.org
OBSERVER_AGENT_PORT=8889
# Must be the name the token was created for: python run.py agent-add web-01
OBSERVER_AGENT_NAME=web-01
# auto = all non-loopback interfaces, or a specific interface name such as eth0
OBSERVER_AGENT_NIC=auto
OBSERVER_AGENT_INTERVAL=1
OBSERVER_AGENT_LOG_LEVEL=INFO
# TLS to a TLS-terminating proxy in front of the listener (see README); optional CA file for private CAs
# OBSERVER_AGENT_TLS=1
# OBSERVER_AGENT_TLS_CA=/etc/observer-agent/ca.pem
