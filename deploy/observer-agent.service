[Unit]
Description=Observer monitoring agent
Documentation=https://github.com/seetadev/observer-monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Install: copy agent.py to /opt/observer-agent/, create a venv with psutil there, then see README ("Agent").
ExecStart=/opt/observer-agent/venv/bin/python /opt/observer-agent/agent.py
EnvironmentFile=/etc/observer-agent/agent.env
# The token is handed over as a systemd credential (readable only by this service) instead of an env value.
LoadCredential=token:/etc/observer-agent/token
Environment=OBSERVER_AGENT_TOKEN_FILE=%d/token
Restart=always
RestartSec=5
DynamicUser=yes

# Hardening: the agent only reads system counters and talks to one TCP port.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
